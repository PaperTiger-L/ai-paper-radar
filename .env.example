# ============ AI Paper Radar 环境变量示例 ============
# 复制为 .env 后修改：  cp .env.example .env
# 注意：.env 包含敏感信息，不要提交到 GitHub（已在 .gitignore 中忽略）。

# 管理员登录账号（仅首次启动时写入数据库，之后请在后台修改密码）
ADMIN_USERNAME=admin@paper-radar.local
ADMIN_PASSWORD=请修改为强密码（至少8位）

# JWT 签名密钥（留空则首次启动自动生成并持久化到数据库）
# JWT_SECRET=

# 服务端口与时区
PORT=8000
TZ=Asia/Shanghai
